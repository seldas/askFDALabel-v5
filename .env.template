
DEFAULT_AI_MODEL=elsa

## SAML SSO (start_server selects Keycloak for dev/prod, FDA for --rapid)
# Keycloak application ORIGIN only: scheme + hostname + optional port, no path.
# Rapid derives its public origin from FDA_SAML_ACS_URL instead.
# Local dev default: http://localhost:8841
# HPC behind HTTPS proxy: https://ncshpcgpu01.fda.gov
# Rootless Apptainer nginx: https://ncshpcgpu01.fda.gov:8443 (or HTTP :8080)
# Set this explicitly when accessing the app from another machine or proxy.
# Docker prod auto-detects from API_SERVER_HOST and matching NEXT_PUBLIC_WIDGET_HOST.
# Docker dev keeps localhost unless SSO_PUBLIC_ORIGIN is explicitly set.
SSO_PUBLIC_ORIGIN=

# FDA SSO: fill with the EXISTING pre-prod registration; never invent these.
# Entity ID is an exact identifier, not necessarily a reachable URL.
FDA_SAML_ENTITY_ID=https://askfdalabel-nctr.preprod.fda.gov
# Complete registered ACS URL including https, host and external path prefix.
FDA_SAML_ACS_URL=https://askfdalabel-nctr.preprod.fda.gov/api/auth/saml
# Backend route after the reverse proxy strips the external API prefix.
# Change only if the registered ACS maps to a different backend path.
FDA_SAML_ACS_PATH=/api/auth/saml

# Test Keycloak: normally leave blank; start_server derives these from origin.
# With bundled nginx, the browser-facing URL must end in /sso.
# Without nginx, default is http://<app-host>:8843.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_SP_ENTITY_ID=
# Local/HPC Keycloak test account; never used by rapid/FDA SSO.
# Changing either value selects a new test realm profile on next startup.
KEYCLOAK_TEST_USERNAME=leihong
KEYCLOAK_TEST_PASSWORD=1986414
# Generated admin/test credentials: data/keycloak/<profile>/credentials.json.
# Optional SP certificate/private key paths INSIDE the backend container.
# Configure both if FDA requires signed requests or encrypted assertions.
SAML_SP_CERT_FILE=
SAML_SP_KEY_FILE=

