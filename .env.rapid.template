# ==============================================================================
# askFDALabel — RAPID Environment Configuration Template
# ==============================================================================
# Copy this file to .env on the RAPID target server:
#   cp .env.rapid.template .env
# Then update the credentials and host addresses below.
# ==============================================================================

## AI Configuration (Restricted to Elsa & Local vLLM in RAPID)
DEFAULT_AI_MODEL=elsa
ALLOWED_AI_PROVIDERS=elsa,vllm

# 1. Elsa API Configuration (Internal FDA LLM Gateway)
ELSA_API_URL=https://elsa-dev.preprod.fda.gov/Monolith/api/engine/runPixel
ELSA_API_NAME=
ELSA_API_KEY=
ELSA_MODEL_ID=8405ac40-89c6-4613-848c-3d89986fbc01
ELSA_MODEL_NAME=CLAUDE_46_SONNET

# 2. Local vLLM Configuration (Internal OpenAI-compatible GPU endpoint)
LLM_URL=http://<vllm-host>:8000/v1
LLM_KEY=EMPTY
LLM_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

## Remote PostgreSQL Database (RAPID uses a fixed remote DB)
LOCAL-PG=false

PG_HOST=10.0.0.1
PG_PORT=5432
PG_DATABASE=askfdalabel
PG_USERNAME=afd_user
PG_PASSWORD=

# Connection string constructed dynamically from credentials above:
DATABASE_URL=postgresql://${PG_USERNAME}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}

## FDALabel Oracle Database (Internal Proxy IP 10.*)
FDALabel_USER=
FDALabel_PASSWORD=

# Oracle DEV Database Proxy
FDALABEL_DEV_HOST=10.0.0.2
FDALABEL_DEV_PORT=1521
FDALABEL_DEV_SERVICE=scidevl03

# Oracle TST Database Proxy
FDALABEL_TST_HOST=10.0.0.3
FDALABEL_TST_PORT=1521
FDALABEL_TST_SERVICE=lbltst2

LOCAL_QUERY=True

## Application Server & Port Configuration
# In RAPID, external Nginx proxies traffic to frontend (8841) and backend (8842)
HOST=0.0.0.0
BACKEND_PORT=8842
FRONTEND_PORT=8841

NEXT_PUBLIC_API_BASE=/fdalabel-v3_api
NEXT_PUBLIC_DASHBOARD_BASE=/fdalabel-v3
API_SERVER_HOST=ncshpcgpu01.fda.gov
NEXT_PUBLIC_API_SERVER_HOST=ncshpcgpu01.fda.gov
